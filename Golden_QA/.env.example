# Postgres (z hosta — notebook łączy się na localhost:5445)
POSTGRES_V2_URL=postgresql+psycopg://admin:admin@localhost:5445/papers_db_v2

# Gemini — wymagane
GEMINI_API_KEY=
GOLDEN_GEMINI_MODEL=gemini-2.0-flash

# Rate limits (429)
GOLDEN_REQUEST_DELAY_SEC=10
GOLDEN_MAX_RETRIES=8
GOLDEN_RETRY_BASE_SEC=20

# Losowanie chunków
GOLDEN_NUM_PAPERS=25
GOLDEN_CHUNKS_PER_PAPER=5
GOLDEN_MIN_CHUNK_CHARS=400
