# Połączenie z Postgres (host: docker compose port)
POSTGRES_URL=postgresql+psycopg://admin:admin@localhost:5444/papers_db

# Google AI Studio / Gemini
GEMINI_API_KEY=your-api-key-here

# Sędzia RAGAS (Exp.1): gemini | ollama
RAGAS_JUDGE=ollama

# Gemini (RAGAS_JUDGE=gemini) — limity dzienne API
GEMINI_MODEL=gemini-3.1-pro-preview
RAGAS_EMBED_MODEL=models/text-embedding-004

# Ollama (RAGAS_JUDGE=ollama) — bez limitów Gemini, ten sam stack co RAG
OLLAMA_BASE_URL=http://localhost:11434
RAGAS_OLLAMA_MODEL=gemma4:e2b
RAGAS_OLLAMA_EMBED_MODEL=nomic-embed-text
RAGAS_TIMEOUT_SEC=600
RAGAS_MAX_WORKERS=3
RAGAS_QUESTION_WORKERS=2

# Masowa generacja Golden QA — Flash = wyższe limity RPM (mniej 429)
GOLDEN_GEMINI_MODEL=gemini-2.0-flash
GOLDEN_REQUEST_DELAY_SEC=10
GOLDEN_MAX_RETRIES=8
GOLDEN_RETRY_BASE_SEC=20

# FastAPI RAG (docker compose: api na :8000)
API_BASE_URL=http://localhost:8000

# Eksperyment 1: wpływ Top-K (tylko mode=chunks, classic)
EXPERIMENT_TOP_K=1,3,5,10,20
EXPERIMENT_QUERY_STRATEGY=classic
EXPERIMENT_SAMPLE_LIMIT=0
EXPERIMENT_REQUEST_DELAY_SEC=0.5

# Parametry generacji Golden QA
GOLDEN_NUM_PAPERS=25
GOLDEN_CHUNKS_PER_PAPER=5
GOLDEN_MIN_CHUNK_CHARS=400
