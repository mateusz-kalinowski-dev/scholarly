# Postgres (ParadeDB, parent-child chunks, golden_qa, evaluation_runs)
POSTGRES_URL=postgresql+psycopg://admin:admin@localhost:5445/papers_db_v2
# alias używany w notebookach Golden QA
POSTGRES_V2_URL=postgresql+psycopg://admin:admin@localhost:5445/papers_db_v2

# Google AI Studio / Gemini — generacja Q/A
GEMINI_API_KEY=
GOLDEN_GEMINI_MODEL=gemini-2.0-flash

# Rate limits Gemini (429) — większe opóźnienie = mniej błędów
GOLDEN_REQUEST_DELAY_SEC=10
GOLDEN_MAX_RETRIES=8
GOLDEN_RETRY_BASE_SEC=20

# Losowanie chunków → pytania
GOLDEN_NUM_PAPERS=25
GOLDEN_CHUNKS_PER_PAPER=5
GOLDEN_MIN_CHUNK_CHARS=400
