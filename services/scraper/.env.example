RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# arXiv — limity (oficjalnie ~1 req / 3s)
ARXIV_PAGE_SIZE=200
ARXIV_REQUEST_DELAY=3.0
ARXIV_MAX_PAGES_PER_RUN=40
ARXIV_MAX_RETRIES=3
ARXIV_USER_AGENT=mailto:student@uczelnia.pl - ScholarlyRAG/1.0

# Fresh start: 30 dni wstecz (backfill), potem co godzinę
INITIAL_LOOKBACK_DAYS=30
SCRAPER_INTERVAL_SECONDS=3600
