RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql://admin:admin@postgres:5432/papers_db

ARXIV_PAGE_SIZE=200
ARXIV_REQUEST_DELAY=5.0
ARXIV_MAX_RETRIES=6
# 0 = jeden cykl paginuje do końca miesiąca (szybki zrzut)
ARXIV_MAX_PAGES_PER_RUN=0
INITIAL_LOOKBACK_DAYS=30
# 2 minuty przerwy po zakończonym cyklu
SCRAPER_INTERVAL_SECONDS=120
# Zapis checkpointu co N wrzuconych na kolejkę
CHECKPOINT_COMMIT_EVERY=25
# true = przy starcie kontenera usuń checkpoint i wymuś backfill
SCRAPER_RESET_ON_START=false
ARXIV_USER_AGENT=mailto:student@uczelnia.pl - ScholarlyRAG/1.0
