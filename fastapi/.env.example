# Połączenie (w Dockerze nadpisuje docker-compose.yml)
POSTGRES_URL=postgresql://admin:admin@postgres:5432/papers_db_v2
OLLAMA_BASE_URL=http://ollama:11434

# Modele
EMBED_MODEL=bge-m3
EMBED_DIM=1024
LLM_MODEL=gemma4:e2b

# OpenAI — tylko wariant eksperyment2-openai (opcjonalnie; można też z root .env)
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Reranker (CUDA w compose)
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cuda

# Self-RAG
SELF_RAG_ENABLED=true
SELF_RAG_POST_GEN_ENABLED=false

CORS_ORIGINS=*

# Pozostałe parametry RAG (hybrid, limity kontekstu) — domyślne w app/config.py
# lub nadpisane w sekcji environment: docker-compose.yml → api
