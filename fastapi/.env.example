POSTGRES_URL=postgresql://admin:admin@postgres:5432/papers_db
POSTGRES_V2_URL=postgresql://admin:admin@postgres_v2:5432/papers_db_v2
OLLAMA_BASE_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text
EMBED_MODEL_V2=bge-m3
EMBED_DIM_V2=1024
LLM_MODEL=gemma4:e2b
DEFAULT_TOP_K=5
HIERARCHICAL_PAPER_LIMIT=5
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_TEXT_WEIGHT=0.35
HYBRID_CANDIDATE_MULTIPLIER=8
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
SELF_RAG_ENABLED=true
SELF_RAG_MIN_CONFIDENCE=0.45
SELF_RAG_MAX_RETRIES=1
CORS_ORIGINS=*
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
