# === Wspólne (notebooki 01–08) ===
EVAL_BATCH_ID=eval-main
POSTGRES_V2_URL=postgresql+psycopg://admin:admin@localhost:5445/papers_db_v2

# === 01 — zbieranie odpowiedzi API ===
API_BASE_URL=http://localhost:8000
RESEARCH_VARIANTS=baseline0,baseline1,eksperyment1-gin,eksperyment1-bm25,eksperyment2
TOP_K=5
SAMPLE_LIMIT=0
REQUEST_TIMEOUT_SEC=600
REQUEST_DELAY_SEC=0.5
REQUEST_MAX_RETRIES=3

# === 02 — Ragas (Ollama jako judge) ===
OLLAMA_BASE_URL=http://localhost:11434
RAGAS_OLLAMA_MODEL=gemma4:e2b
RAGAS_OLLAMA_EMBED_MODEL=bge-m3
RAGAS_QUESTION_WORKERS=2
RAGAS_MAX_WORKERS=3
RAGAS_TIMEOUT_SEC=600
# RAGAS_METRICS=faithfulness,answer_correctness,answer_relevancy,context_precision,context_recall

# === 04–05 — DeepEval (OpenAI jako judge) ===
OPENAI_API_KEY=
DEEPEVAL_MODEL=gpt-4o-mini
DEEPEVAL_WORKERS=8
DEEPEVAL_METRICS=faithfulness,answer_relevancy,contextual_recall,contextual_precision,answer_correctness
DEEPEVAL_TELEMETRY_OPT_OUT=1

